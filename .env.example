# ToonForge environment — copy to .env and fill in values.
# NEVER commit real credentials.

# Runtime
NODE_ENV=development
TOONFORGE_DATA_DIR=./data
TOONFORGE_LOG_LEVEL=info
TOONFORGE_KILL_SWITCH=false

# Budgets / safety
TOONFORGE_DAILY_BUDGET_USD=25
TOONFORGE_PER_VIDEO_BUDGET_USD=5
TOONFORGE_MAX_CONCURRENT_JOBS=1
TOONFORGE_MAX_RETRIES=3

# OmniChar (optional, process-isolated GPL engine — do not import as a library)
# Default endpoint matches OmniChar Core: http://127.0.0.1:8848
# OMNICHAR_ENABLED=false
# OMNICHAR_BASE_URL=http://127.0.0.1:8848
# OMNICHAR_TIMEOUT_MS=10000
# OMNICHAR_MAX_RETRIES=3

# OpenMontage (optional local character-animation backend — AGPL-3.0; do not vendor source)
# Install separately: https://github.com/calesthio/OpenMontage
# OPENMONTAGE_ENABLED=false
# OPENMONTAGE_ROOT=/absolute/path/to/OpenMontage
# OPENMONTAGE_PYTHON=python3
# OPENMONTAGE_TIMEOUT_MS=120000
# OPENMONTAGE_MAX_RETRIES=1

# ReelMimic (optional local production server — MIT; do not vendor source)
# Install: cd /path/to/reelmimic && ./install.sh && ./start.sh
# Default endpoint: http://127.0.0.1:4318
# REELMIMIC_ENABLED=false
# REELMIMIC_BASE_URL=http://127.0.0.1:4318
# REELMIMIC_ROOT=/path/to/reelmimic
# REELMIMIC_TIMEOUT_MS=30000
# REELMIMIC_MAX_RETRIES=3

# Media
# Dry-run / CI uses FFmpeg fixtures (kind=ffmpeg_dev). Live publish requires
# ReelMimic/provider media — never text placeholder .mp4 files.
# openmontage and reelmimic refuse those tones for narration and music.
# TOONFORGE_TTS_PROVIDER=piper
# TOONFORGE_PIPER_PYTHON=/absolute/path/to/python
# TOONFORGE_PIPER_MODEL=/absolute/path/to/en_US-ljspeech-high.onnx
# TOONFORGE_TTS_LICENSE=public-domain
# TOONFORGE_TTS_ATTRIBUTION=LJ Speech public-domain dataset; Piper software is MIT
# TOONFORGE_TTS_SOURCE_URL=https://keithito.com/LJ-Speech-Dataset/
# TOONFORGE_MUSIC_FILE=/absolute/path/to/track.mp3
# TOONFORGE_MUSIC_LICENSE=cc-by-3.0
# TOONFORGE_MUSIC_TITLE=Carefree
# TOONFORGE_MUSIC_ATTRIBUTION=Carefree by Kevin MacLeod (incompetech.com) CC BY 3.0
# TOONFORGE_MUSIC_SOURCE_URL=https://commons.wikimedia.org/wiki/File:Carefree_(ISRC_USUAN1400037).mp3

# Ruflo orchestration (optional; local fallback used when disabled)
# RUFLO_ENABLED=false
# RUFLO_MCP_COMMAND=npx
# RUFLO_MCP_ARGS=-y,ruflo@latest,mcp,start

# YouTube Data API v3 OAuth (Desktop app credentials) — publishing only
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# Canonical loopback callback. The default is this URI when the variable is unset.
# Google Cloud must register the same URI, including the trailing slash.
# YOUTUBE_REDIRECT_URI=http://127.0.0.1:53682/
# Publish target. This is not proof the OAuth account controls the channel.
# YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx
# YOUTUBE_TOKEN_PATH=./data/youtube-token.json
# DEFAULT_PRIVACY_STATUS=private
# YOUTUBE_DRY_RUN=true
# Live uploads also require: toonforge publish enable-live --i-understand
# YOUTUBE_REGION=US

# HTTP MCP for ChatGPT or other remote clients. Loopback only.
# Put TLS in a reverse proxy. Never expose this without the bearer token.
# TOONFORGE_MCP_TOKEN=
# TOONFORGE_MCP_PORT=8787
# TOONFORGE_MCP_MAX_BYTES=262144

# YouTube Data API v3 — read-only trend discovery (API key, NOT OAuth)
# Separate from publishing credentials. Never commit the key.
# TOONFORGE_YOUTUBE_TRENDS_ENABLED=false
# YOUTUBE_DATA_API_KEY=
# YOUTUBE_TRENDS_REGION=US
# YOUTUBE_TRENDS_CATEGORY_ID=
# YOUTUBE_TRENDS_MAX_RESULTS=25
# YOUTUBE_TRENDS_TIMEOUT_MS=15000
# YOUTUBE_TRENDS_MAX_RETRIES=3

# Optional AI providers (used by later phases; leave unset for mocked e2e)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
