<?xml version="1.0" encoding="UTF-16"?>
<!-- Windows Task Scheduler template for the current user.
     Do not store OAuth tokens in this file. toonforge setup does not register the task. -->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
    </LogonTrigger>
  </Triggers>
  <Actions>
    <Exec>
      <Command>toonforge</Command>
      <Arguments>scheduler start</Arguments>
    </Exec>
  </Actions>
</Task>
